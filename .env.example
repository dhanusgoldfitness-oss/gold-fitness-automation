# Copy to .env for local use. On Render, add these under Environment. Never commit real values.

# --- Storage: Google Sheets (used when GOOGLE_SHEET_ID is set) ---
GOOGLE_SHEET_ID=1Nf2mlWhN7HBpWCcLBgXzbTWcchYVp1KcLhrT92zXIxI
# The whole service account JSON on ONE line (or base64 of it). Never put the key file in the project or in git.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Storage: Supabase (only if GOOGLE_SHEET_ID is left empty) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # System User token (permanent), not the 24h test token

# Instagram messaging (optional until Instagram is connected)
IG_ACCESS_TOKEN=

# Webhook security
VERIFY_TOKEN=               # any random string; paste the same value in Meta's webhook setup
META_APP_SECRET=            # Meta app > Settings > Basic > App secret
IG_APP_SECRET=              # only if the Instagram app is a different Meta app

# Admin endpoints (/admin/*). Use a long random string.
ADMIN_KEY=

# Owner alerts for new trial requests (digits only, with country code; several numbers separated by commas)
OWNER_PHONE=
